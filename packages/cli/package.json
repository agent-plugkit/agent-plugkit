{
  "name": "agent-plugkit",
  "version": "0.1.1",
  "private": false,
  "description": "CLI toolkit for building and maintaining AI agent plugin marketplaces",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-plugkit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-plugkit/agent-plugkit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/agent-plugkit/agent-plugkit/issues"
  },
  "homepage": "https://github.com/agent-plugkit/agent-plugkit#readme",
  "scripts": {
    "clean": "rm -rf dist src/generated tsconfig.tsbuildinfo",
    "generate:skill": "tsx scripts/generate-skill.ts",
    "build": "npm run clean && npm run generate:skill && tsc && cp scripts/npm-dist.npmignore dist/.npmignore && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "test": "npm run test:cli && npm run test:package",
    "test:cli": "npm run test:install-repo && tsx scripts/test-cli.ts",
    "test:install-repo": "tsx scripts/test-install-repo.ts",
    "test:package": "npm run build && tsx scripts/test-package.ts",
    "preagent-plugkit": "npm run generate:skill",
    "agent-plugkit": "tsx src/cli.ts",
    "predev": "npm run generate:skill",
    "dev": "tsx watch src/cli.ts"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "js-yaml": "^4.3.1",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
